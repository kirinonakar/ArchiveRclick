import {
    Button,
    CheckBox,
    ComboBox,
    LineEdit,
    ListView,
    Palette
} from "std-widgets.slint";
import { CreateOverlay, ExtractOverlay, SettingsOverlay } from "dialogs.slint";
import { ConflictOverlay, ProgressOverlay } from "progress.slint";

export struct ArchiveRow {
    selected: bool,
    is-folder: bool,
    name: string,
    size: string,
    packed: string,
    modified: string,
    path: string,
}

component HeaderCell inherits Rectangle {
    in property <string> label;
    in property <int> column-index;
    callback sort(int);

    background: pointer.has-hover ? Palette.control-background : transparent;
    border-radius: 6px;
    accessible-role: button;
    accessible-label: "Sort by " + root.label;

    Text {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.label + "  ↕";
        color: Palette.foreground;
        font-weight: 600;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }

    pointer := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.sort(root.column-index); }
    }
}

component ArchiveTableHeader inherits Rectangle {
    callback sort(int);

    private property <length> content-width: self.width - 36px;
    height: 30px;
    background: Palette.alternate-background;
    border-radius: 10px;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;

    Rectangle {
        x: 0px;
        width: 36px;
        height: parent.height;
        background: Palette.alternate-background;
        border-radius: 10px;
        border-top-right-radius: 0px;
        border-bottom-left-radius: 0px;
        border-bottom-right-radius: 0px;
    }

    HeaderCell {
        x: 36px;
        width: root.content-width * 0.28;
        height: parent.height;
        label: "Name";
        column-index: 0;
        sort(column) => { root.sort(column); }
    }

    HeaderCell {
        x: 36px + root.content-width * 0.28;
        width: root.content-width * 0.12;
        height: parent.height;
        label: "Size";
        column-index: 1;
        sort(column) => { root.sort(column); }
    }

    HeaderCell {
        x: 36px + root.content-width * 0.40;
        width: root.content-width * 0.12;
        height: parent.height;
        label: "Packed";
        column-index: 2;
        sort(column) => { root.sort(column); }
    }

    HeaderCell {
        x: 36px + root.content-width * 0.52;
        width: root.content-width * 0.18;
        height: parent.height;
        label: "Modified";
        column-index: 3;
        sort(column) => { root.sort(column); }
    }

    HeaderCell {
        x: 36px + root.content-width * 0.70;
        width: root.content-width * 0.30;
        height: parent.height;
        label: "Path";
        column-index: 4;
        sort(column) => { root.sort(column); }
    }
}

component ArchiveListRow inherits Rectangle {
    in property <ArchiveRow> entry;
    in property <int> row-index;
    in property <int> language-index;
    in property <bool> context-menu-enabled: true;
    callback toggle(int);
    callback activate(int);
    callback extract-context(int);

    private property <length> content-width: self.width - 36px;
    height: 28px;
    background: root.entry.selected ? Palette.selection-background
        : row-pointer.has-hover ? Palette.control-background : transparent;
    border-radius: 6px;
    accessible-role: list-item;
    accessible-label: root.entry.name;
    accessible-item-selectable: true;
    accessible-item-selected: root.entry.selected;
    accessible-item-index: root.row-index;

    CheckBox {
        x: 6px;
        y: 1px;
        width: 24px;
        height: parent.height - 2px;
        checked: root.entry.selected;
        text: "";
        toggled => { root.toggle(root.row-index); }
    }

    Text {
        x: 40px;
        width: root.content-width * 0.28 - 4px;
        height: parent.height;
        text: root.entry.name;
        color: root.entry.selected ? Palette.selection-foreground : Palette.foreground;
        font-weight: root.entry.is-folder ? 600 : 400;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: 36px + root.content-width * 0.28 + 6px;
        width: root.content-width * 0.12 - 12px;
        height: parent.height;
        text: root.entry.size;
        color: root.entry.selected ? Palette.selection-foreground : Palette.foreground;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: 36px + root.content-width * 0.40 + 6px;
        width: root.content-width * 0.12 - 12px;
        height: parent.height;
        text: root.entry.packed;
        color: root.entry.selected ? Palette.selection-foreground : Palette.foreground;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: 36px + root.content-width * 0.52 + 8px;
        width: root.content-width * 0.18 - 16px;
        height: parent.height;
        text: root.entry.modified;
        color: root.entry.selected ? Palette.selection-foreground : Palette.foreground;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: 36px + root.content-width * 0.70 + 8px;
        width: root.content-width * 0.30 - 16px;
        height: parent.height;
        text: root.entry.path;
        color: root.entry.selected ? Palette.selection-foreground : Palette.foreground;
        vertical-alignment: center;
        overflow: elide;
    }

    row-pointer := TouchArea {
        x: 36px;
        width: parent.width - 36px;
        height: parent.height;
        mouse-cursor: root.entry.is-folder ? pointer : default;
        clicked => { root.toggle(root.row-index); }
        double-clicked => { root.activate(root.row-index); }
    }

    context-menu := ContextMenuArea {
        width: parent.width;
        height: parent.height;
        enabled: root.context-menu-enabled;

        Menu {
            MenuItem {
                title: root.language-index == 1
                    ? "선택 항목 압축 풀기…"
                    : root.language-index == 2
                        ? "選択項目を展開…"
                        : "Extract selected item(s)…";
                activated => { root.extract-context(root.row-index); }
            }
        }
    }
}

component IconToolButton inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    callback clicked;

    width: 38px;
    height: 38px;
    border-radius: 9px;
    // Ghost controls stay transparent at rest; hover/focus uses a very light
    // black wash so the affordance feels slightly darker, never brighter.
    background: !root.enabled ? transparent
        : touch.has-hover ? #00000012 : transparent;
    border-width: 0px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }

        Text {
            text: root.glyph;
            font-family: "Segoe MDL2 Assets";
            font-size: 19px;
            color: root.enabled ? (root.primary ? Palette.accent-background : Palette.foreground) : Palette.foreground;
            opacity: root.enabled ? 1.0 : 0.38;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Tooltip {
            text: @markdown("\{root.label}");
        }
    }
}

export component AppWindow inherits Window {
    in-out property <[ArchiveRow]> archive-rows;
    in-out property <string> archive-title;
    in-out property <string> current-folder;
    in-out property <string> status-text;
    in-out property <string> summary-text;
    in-out property <string> libarchive-version;
    in-out property <bool> has-archive;
    in-out property <bool> busy;
    in-out property <bool> can-go-up;

    in-out property <bool> progress-visible;
    in-out property <string> progress-title;
    in-out property <string> progress-file;
    in-out property <string> progress-percent;
    in-out property <string> progress-elapsed;
    in-out property <string> progress-remaining;
    in-out property <string> progress-total;
    in-out property <string> progress-detail;
    in-out property <float> progress-value;

    in-out property <bool> conflict-visible;
    in-out property <string> conflict-path;

    in-out property <bool> create-visible;
    in-out property <string> create-source-summary;
    in-out property <string> create-destination;
    in-out property <[string]> create-formats;
    in-out property <bool> create-has-sources;
    in-out property <int> create-thread-selection: 0;

    in-out property <bool> password-visible;
    in-out property <string> password-operation;
    in-out property <string> password-value;

    in-out property <string> font-family;
    in-out property <[string]> font-options;
    in-out property <int> font-selection;
    in-out property <int> settings-thread-selection: 0;
    in-out property <int> theme-selection: 0;
    in-out property <[string]> language-options;
    in-out property <int> language-selection: 0;
    in-out property <[string]> encoding-options;
    in-out property <int> encoding-selection: 0;
    in-out property <int> selection-state: 0;
    in-out property <bool> settings-visible;
    in-out property <string> context-menu-state;

    callback open-requested();
    callback up-requested();
    callback toggle-selection(int);
    callback select-all-requested(bool);
    callback activate-row(int);
    callback extract-context-requested(int);
    callback sort-requested(int);
    callback encoding-selection-changed(int);
    callback show-extract-requested();
    callback extract-requested(int, int, string, bool);
    callback prepare-create-requested();
    callback choose-create-files-requested();
    callback choose-create-folder-requested();
    callback create-requested(int, int, int, string);
    callback test-requested();
    callback cancel-requested();
    callback conflict-response(int);
    callback password-response(string, bool);
    callback dropped(data-transfer);

    callback settings-requested();
    callback settings-applied(int, int, int, int);
    callback settings-cancelled();
    callback context-menu-register-requested();
    callback context-menu-unregister-requested();

    in-out property <bool> extract-visible: false;
    in-out property <bool> extract-selected-only: false;

    title: root.archive-title == "" ? "ArchiveRclick" : root.archive-title + " — ArchiveRclick";
    icon: @image-url("../app.png");
    default-font-family: root.font-family == "" ? "Yu Gothic" : root.font-family;
    preferred-width: 1040px;
    preferred-height: 600px;
    // Keep the compact layout usable on narrow screens.  The flexible path
    // field yields first, while the fixed controls remain accessible.
    min-width: 520px;
    min-height: 400px;
    background: Palette.background;

    // Theme selection: 0 = follow the system, 1 = light, 2 = dark.
    changed theme-selection => {
        Palette.color-scheme = root.theme-selection == 1 ? ColorScheme.light
            : root.theme-selection == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }

    forward-focus: shortcuts;
    shortcuts := FocusScope {
        width: parent.width;
        height: parent.height;
        focus-on-click: false;

        KeyBinding {
            keys: @keys(Control + O);
            enabled: !root.busy;
            activated => { root.open-requested(); }
        }

        KeyBinding {
            keys: @keys(Alt + LeftArrow);
            enabled: root.can-go-up && !root.busy;
            activated => { root.up-requested(); }
        }

        KeyBinding {
            keys: @keys(Escape);
            activated => {
                if (root.conflict-visible) {
                    root.conflict-response(4);
                } else if (root.progress-visible || root.busy) {
                    root.cancel-requested();
                } else if (root.settings-visible) {
                    root.settings-visible = false;
                } else if (root.create-visible) {
                    root.create-visible = false;
                } else if (root.extract-visible) {
                    root.extract-visible = false;
                }
            }
        }

        drop-target := DropArea {
            width: parent.width;
            height: parent.height;

            can-drop(event) => {
                return root.busy || root.password-visible || root.conflict-visible || root.create-visible || root.extract-visible || root.settings-visible ? DragAction.none : DragAction.copy;
            }

            dropped(event) => {
                if (root.busy || root.password-visible || root.conflict-visible || root.create-visible || root.extract-visible || root.settings-visible) {
                    return DragAction.none;
                }
                root.dropped(event.data);
                return DragAction.copy;
            }

            VerticalLayout {
                width: parent.width;
                height: parent.height;
                spacing: 0px;

                // ---------------- Compact icon toolbar ----------------
                Rectangle {
                    height: 56px;
                    background: Palette.background;
                    // A soft shadow creates a lighter visual break than a
                    // full-width border while keeping the toolbar compact.
                    drop-shadow-blur: 10px;
                    drop-shadow-color: #00000012;
                    drop-shadow-offset-y: 2px;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 7px;
                        padding-bottom: 7px;
                        spacing: 8px;

                        IconToolButton {
                            glyph: "\u{E8E5}";
                            label: root.language-selection == 1 ? "열기" : root.language-selection == 2 ? "開く" : "Open";
                            primary: true;
                            enabled: !root.busy;
                            clicked => { root.open-requested(); }
                        }

                        IconToolButton {
                            glyph: "\u{E896}";
                            label: root.language-selection == 1 ? "압축 풀기" : root.language-selection == 2 ? "展開" : "Extract";
                            enabled: root.has-archive && !root.busy;
                            clicked => {
                                root.extract-selected-only = false;
                                root.show-extract-requested();
                                root.extract-visible = true;
                            }
                        }

                        IconToolButton {
                            glyph: "\u{E74E}";
                            label: root.language-selection == 1 ? "압축하기" : root.language-selection == 2 ? "圧縮" : "Compress";
                            enabled: !root.busy;
                            clicked => { root.prepare-create-requested(); }
                        }

                        IconToolButton {
                            glyph: "\u{E73E}";
                            label: root.language-selection == 1 ? "테스트" : root.language-selection == 2 ? "テスト" : "Test";
                            enabled: root.has-archive && !root.busy;
                            clicked => { root.test-requested(); }
                        }

                        Rectangle { horizontal-stretch: 1; }

                        IconToolButton {
                            glyph: "\u{E713}";
                            label: root.language-selection == 1 ? "설정" : root.language-selection == 2 ? "設定" : "Settings";
                            enabled: !root.busy;
                            clicked => { root.settings-requested(); }
                        }
                    }
                }

                // ---------------- Path bar ----------------
                Rectangle {
                    height: 42px;
                    background: Palette.background;
                    // Keep this surface visually connected to the toolbar;
                    // the rounded path field below provides the actual
                    // control boundary.
                    drop-shadow-blur: 8px;
                    drop-shadow-color: #0000000a;
                    drop-shadow-offset-y: 1px;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 4px;
                        padding-bottom: 4px;
                        spacing: 8px;

                        IconToolButton {
                            width: 34px;
                            height: 34px;
                            glyph: "\u{E74A}";
                            label: root.language-selection == 1 ? "위로" : root.language-selection == 2 ? "上へ" : "Up";
                            enabled: root.can-go-up && !root.busy;
                            clicked => { root.up-requested(); }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 8px;
                            background: Palette.control-background;
                            border-width: 1px;
                            border-color: Palette.border;
                            clip: true;

                            Text {
                                x: 12px;
                                width: parent.width - 24px;
                                height: parent.height;
                                text: root.has-archive
                                    ? (root.current-folder == "" ? "/" : root.current-folder)
                                    : (root.language-selection == 1 ? "열린 압축파일 없음" : root.language-selection == 2 ? "アーカイブ未選択" : "No archive open");
                                color: Palette.foreground;
                                font-size: 13px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        Text {
                            text: "Code page";
                            width: 62px;
                            color: Palette.foreground;
                            opacity: 0.72;
                            font-size: 11px;
                            vertical-alignment: center;
                        }

                        ComboBox {
                            // Keep the longest English entry (for example,
                            // "CP950 — Traditional Chinese") fully visible.
                            width: 230px;
                            model: root.encoding-options;
                            current-index: root.encoding-selection;
                            accessible-label: "Code page";
                            changed current-index => {
                                root.encoding-selection = self.current-index;
                                root.encoding-selection-changed(self.current-index);
                            }
                        }

                    }
                }

                // ---------------- Archive contents ----------------
                if root.has-archive : Rectangle {
                    vertical-stretch: 1;
                    background: Palette.background;

                    VerticalLayout {
                        spacing: 6px;
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 8px;
                        padding-bottom: 8px;

                        HorizontalLayout {
                            height: 28px;
                            spacing: 8px;

                            CheckBox {
                                text: root.language-selection == 1 ? "전체 선택" : root.language-selection == 2 ? "すべて選択" : "Select all";
                                checked: root.selection-state == 2;
                                enabled: root.archive-rows.length > 0 && !root.busy;
                                toggled => { root.select-all-requested(self.checked); }
                            }

                            Text {
                                text: root.selection-state == 2
                                    ? (root.language-selection == 1 ? "현재 폴더의 모든 항목 선택됨" : root.language-selection == 2 ? "現在のフォルダーをすべて選択中" : "All items in this folder selected")
                                    : root.selection-state == 1
                                        ? (root.language-selection == 1 ? "일부 항목 선택됨" : root.language-selection == 2 ? "一部の項目を選択中" : "Some items selected")
                                        : "";
                                color: Palette.foreground;
                                opacity: 0.68;
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Rectangle { horizontal-stretch: 1; }

                            IconToolButton {
                                width: 28px;
                                height: 28px;
                                glyph: "\u{E711}";
                                label: root.language-selection == 1 ? "선택 해제" : root.language-selection == 2 ? "選択解除" : "Clear selection";
                                enabled: root.selection-state != 0 && !root.busy;
                                clicked => { root.select-all-requested(false); }
                            }
                        }

                        Rectangle {
                            vertical-stretch: 1;
                            background: Palette.background;
                            border-width: 1px;
                            border-color: Palette.border;
                            border-radius: 10px;
                            clip: true;
                            drop-shadow-blur: 10px;
                            drop-shadow-color: #00000022;
                            drop-shadow-offset-y: 2px;

                            VerticalLayout {
                                spacing: 0px;

                                ArchiveTableHeader {
                                    sort(column) => { root.sort-requested(column); }
                                }

                                ListView {
                                    vertical-stretch: 1;
                                    accessible-role: list;
                                    accessible-label: root.language-selection == 1 ? "압축파일 내용" : root.language-selection == 2 ? "アーカイブの内容" : "Archive contents";
                                    accessible-item-count: root.archive-rows.length;

                                    for row[index] in root.archive-rows : ArchiveListRow {
                                        entry: row;
                                        row-index: index;
                                        language-index: root.language-selection;
                                        context-menu-enabled: !root.busy;
                                        toggle(row-index) => { root.toggle-selection(row-index); }
                                        activate(row-index) => { root.activate-row(row-index); }
                                        extract-context(row-index) => { root.extract-context-requested(row-index); }
                                    }
                                }
                            }
                        }
                    }
                }

                // ---------------- Empty state ----------------
                if !root.has-archive : Rectangle {
                    vertical-stretch: 1;
                    background: Palette.background;

                    VerticalLayout {
                        alignment: center;
                        spacing: 10px;
                        padding: 20px;

                        Text {
                            text: drop-target.has-drag
                                ? (root.language-selection == 1 ? "놓아서 열기" : root.language-selection == 2 ? "ドロップして開く" : "Release to open")
                                : (root.language-selection == 1 ? "압축파일을 열어 내용을 확인하세요" : root.language-selection == 2 ? "アーカイブを開いて内容を確認" : "Open an archive to inspect its contents");
                            color: Palette.foreground;
                            font-size: 19px;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: root.language-selection == 1
                                ? "열기, Ctrl+O, 명령줄 경로 또는 압축파일을 이곳에 끌어다 놓으세요."
                                : root.language-selection == 2
                                    ? "開く、Ctrl+O、コマンドラインパス、またはここへアーカイブをドロップしてください。"
                                    : "Use Open, Ctrl+O, a command-line path, or drag an archive here.";
                            color: Palette.foreground;
                            font-size: 12px;
                            opacity: 0.7;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }

                        Button {
                            text: root.language-selection == 1 ? "압축파일 열기…" : root.language-selection == 2 ? "アーカイブを開く…" : "Open archive…";
                            primary: true;
                            enabled: !root.busy;
                            clicked => { root.open-requested(); }
                        }
                    }
                }

                // ---------------- Status bar ----------------
                Rectangle {
                    height: 26px;
                    background: Palette.alternate-background;
                    border-width: 1px;
                    border-color: Palette.border;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;

                        Text {
                            text: root.summary-text;
                            color: Palette.foreground;
                            font-size: 11px;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }

                        Text {
                            text: root.libarchive-version;
                            color: Palette.foreground;
                            font-size: 11px;
                            opacity: 0.7;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }

    if root.extract-visible : ExtractOverlay {
        language-index: root.language-selection;
        archive-name: root.archive-title;
        selected-only-default: root.extract-selected-only;
        accepted(destination-mode, conflict-policy, password, selected-only) => {
            root.extract-visible = false;
            root.extract-selected-only = false;
            root.extract-requested(destination-mode, conflict-policy, password, selected-only);
        }
        cancelled => {
            root.extract-visible = false;
            root.extract-selected-only = false;
        }
    }

    if root.create-visible : CreateOverlay {
        language-index: root.language-selection;
        source-summary: root.create-source-summary;
        destination: root.create-destination;
        available-formats: root.create-formats;
        has-sources: root.create-has-sources;
        thread-selection: root.create-thread-selection;
        choose-files => { root.choose-create-files-requested(); }
        choose-folder => { root.choose-create-folder-requested(); }
        accepted(format-index, level, thread-index, password) => {
            root.create-visible = false;
            root.create-requested(format-index, level, thread-index, password);
        }
        cancelled => { root.create-visible = false; }
    }

    if root.progress-visible : ProgressOverlay {
        operation-title: root.progress-title;
        current-file: root.progress-file;
        progress-percent: root.progress-percent;
        progress-elapsed: root.progress-elapsed;
        progress-remaining: root.progress-remaining;
        progress-total: root.progress-total;
        detail: root.progress-detail;
        value: root.progress-value;
        cancelled => { root.cancel-requested(); }
    }

    if root.conflict-visible : ConflictOverlay {
        conflict-path: root.conflict-path;
        responded(response) => { root.conflict-response(response); }
    }

    if root.settings-visible : SettingsOverlay {
        font-options: root.font-options;
        font-selection: root.font-selection;
        thread-selection: root.settings-thread-selection;
        theme-selection: root.theme-selection;
        language-options: root.language-options;
        language-selection: root.language-selection;
        context-menu-state: root.context-menu-state;
        register-context-menu => { root.context-menu-register-requested(); }
        unregister-context-menu => { root.context-menu-unregister-requested(); }
        accepted(font-selection, thread-index, theme-index, language-index) => {
            root.settings-visible = false;
            root.settings-applied(font-selection, thread-index, theme-index, language-index);
        }
        cancelled => { root.settings-visible = false; }
    }

    if root.password-visible : Rectangle {
        background: #00000094;
        accessible-role: region;
        accessible-label: root.language-selection == 1 ? "압축파일 암호" : root.language-selection == 2 ? "アーカイブのパスワード" : "Archive password";

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 440px;
            height: 220px;
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            border-radius: 12px;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000055;
            drop-shadow-offset-y: 6px;

            VerticalLayout {
                padding: 18px;
                spacing: 10px;

                Text {
                    text: root.language-selection == 1 ? "암호 필요" : root.language-selection == 2 ? "パスワードが必要です" : "Password required";
                    font-size: 20px;
                    font-weight: 600;
                    color: Palette.foreground;
                }

                Text {
                    text: root.password-operation;
                    color: Palette.foreground;
                    wrap: word-wrap;
                }

                password-entry := LineEdit {
                    input-type: InputType.password;
                    text <=> root.password-value;
                    placeholder-text: root.language-selection == 1 ? "압축파일 암호" : root.language-selection == 2 ? "アーカイブのパスワード" : "Archive password";
                    enabled: true;
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: root.language-selection == 1 ? "취소" : root.language-selection == 2 ? "キャンセル" : "Cancel";
                        clicked => { root.password-response("", false); }
                    }
                    Button {
                        text: root.language-selection == 1 ? "계속" : root.language-selection == 2 ? "続行" : "Continue";
                        primary: true;
                        enabled: password-entry.text != "";
                        clicked => { root.password-response(password-entry.text, true); }
                    }
                }
            }
        }
    }
}
