import {
    Button,
    CheckBox,
    LineEdit,
    ListView,
    Palette
} from "std-widgets.slint";
import { AppTheme } from "theme.slint";
import { CreateOverlay, ExtractOverlay, SettingsOverlay } from "dialogs.slint";
import { ConflictOverlay } from "progress.slint";

export struct ArchiveRow {
    selected: bool,
    is-folder: bool,
    is-executable: bool,
    is-archive: bool,
    name: string,
    size: string,
    packed: string,
    modified: string,
    path: string,
}

component CodePageOption inherits Rectangle {
    in property <string> value;
    in property <bool> selected: false;
    callback clicked;

    width: 100%;
    height: 30px;
    background: option-touch.has-hover
        ? Palette.control-background
        : root.selected ? Palette.alternate-background : transparent;
    accessible-role: list-item;
    accessible-label: root.value;
    accessible-item-selected: root.selected;

    option-text := Text {
        x: 10px;
        width: max(0px, parent.width - 20px);
        height: parent.height;
        text: root.value;
        color: Palette.foreground;
        font-size: 10px;
        vertical-alignment: center;
        overflow: elide;
    }

    option-touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }

        if option-text.preferred-width > option-text.width : Tooltip {
            text: @markdown("\{root.value}");
        }
    }
}

component CodePageComboBox inherits Rectangle {
    in property <[string]> model: [];
    in-out property <int> current-index: 0;
    in property <bool> enabled: true;
    callback selection-changed(int);

    private property <string> current-value: root.model.length > 0
        && root.current-index >= 0
        && root.current-index < root.model.length
            ? root.model[root.current-index] : "";

    width: 180px;
    height: 32px;
    background: root.enabled ? Palette.control-background : Palette.background;
    border-width: 1px;
    border-color: root.enabled ? AppTheme.border : Palette.background;
    border-radius: 3px;
    clip: true;
    accessible-role: combobox;
    accessible-label: "Code page";
    accessible-value: root.current-value;
    accessible-enabled: root.enabled;
    accessible-expandable: true;
    accessible-expanded: popup.is-open;

    selection-text := Text {
        x: 8px;
        width: max(0px, parent.width - 38px);
        height: parent.height;
        text: root.current-value;
        color: root.enabled ? Palette.control-foreground : Palette.foreground;
        font-size: 10px;
        vertical-alignment: center;
        overflow: elide;
    }

    arrow := Image {
        x: parent.width - 29px;
        y: (parent.height - 12px) / 2;
        width: 12px;
        height: 12px;
        source: @image-url("dropdown-arrow.svg");
        colorize: root.enabled ? Palette.foreground : AppTheme.border;
    }

    control-touch := TouchArea {
        enabled: root.enabled;
        width: parent.width;
        height: parent.height;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.toggle-popup(); }

        if selection-text.preferred-width > selection-text.width : Tooltip {
            text: @markdown("\{root.current-value}");
        }
    }

    function toggle-popup() {
        if (!root.enabled || root.model.length == 0) {
            return;
        }
        if (popup.is-open) {
            popup.close();
        } else {
            popup.show();
        }
    }

    function select(index: int) {
        if (index < 0 || index >= root.model.length) {
            return;
        }
        root.current-index = index;
        root.selection-changed(index);
        popup.close();
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height;
        width: root.width;
        height: min(6, root.model.length) * 30px + 2px;
        close-policy: close-on-click-outside;

        popup-frame := Rectangle {
            width: parent.width;
            height: parent.height;
            background: Palette.alternate-background;
            border-width: 1px;
            border-color: AppTheme.border;
            border-radius: 4px;
            clip: true;

            ListView {
                x: 1px;
                y: 1px;
                width: max(0px, parent.width - 2px);
                height: max(0px, parent.height - 2px);

                for value[index] in root.model : CodePageOption {
                    value: value;
                    selected: index == root.current-index;
                    clicked => { root.select(index); }
                }
            }
        }
    }
}

component HeaderCell inherits Rectangle {
    in property <string> label;
    in property <int> column-index;
    in property <length> column-width;
    in property <bool> sorted: false;
    in property <bool> sort-ascending: true;
    in property <bool> resizable: true;
    callback sort(int);
    callback resize(int, length);
    callback resize-finished(int);

    private property <length> drag-start-width: root.column-width;
    private property <length> drag-start-x: 0px;
    private property <bool> resizing: false;

    width: root.column-width;

    background: pointer.has-hover ? Palette.control-background : transparent;
    border-radius: 6px;
    accessible-role: button;
    accessible-label: "Sort by " + root.label;

    Text {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.label + "  " + (root.sorted ? (root.sort-ascending ? "↑" : "↓") : "↕");
        color: Palette.foreground;
        font-weight: 600;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;

        if self.preferred-width > self.width : Tooltip {
            text: @markdown("\{root.label}");
        }
    }

    pointer := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.sort(root.column-index); }
    }

    Rectangle {
        x: parent.width - 1px;
        y: 5px;
        width: 1px;
        height: parent.height - 10px;
        background: resize-handle.has-hover || resize-handle.pressed
            ? Palette.accent-background : AppTheme.border;
        opacity: resize-handle.has-hover || resize-handle.pressed ? 0.9 : 0.32;
    }

    resize-handle := TouchArea {
        enabled: root.resizable;
        x: max(0px, parent.width - 10px);
        width: min(10px, parent.width);
        height: parent.height;
        mouse-cursor: root.resizable ? MouseCursor.ew-resize : MouseCursor.default;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                if (event.button == PointerEventButton.left) {
                    root.resizing = true;
                    root.drag-start-width = root.column-width;
                    root.drag-start-x = self.x + self.mouse-x;
                }
            } else if (event.kind == PointerEventKind.move) {
                // Slint reports PointerEventButton.other for move events.  The
                // resize state set on the left-button down event is therefore
                // the reliable guard for the drag update.
                if (root.resizing) {
                    root.resize(
                        root.column-index,
                        root.drag-start-width + self.x + self.mouse-x - root.drag-start-x
                    );
                }
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                if (root.resizing) {
                    root.resizing = false;
                    root.resize-finished(root.column-index);
                }
            }
        }
    }
}

component ArchiveTextCell inherits Rectangle {
    in property <string> value;
    in property <bool> selected;
    in property <bool> is-folder: false;
    in property <bool> is-executable: false;
    in property <bool> is-archive: false;
    in property <bool> folder-activation: false;
    in property <bool> emphasize: false;
    in property <bool> right-aligned: false;
    in property <length> text-left-padding: 4px;
    in property <length> text-right-padding: 4px;
    private property <bool> drag-active: false;
    private property <length> drag-start-x: 0px;
    private property <length> drag-start-y: 0px;
    // Slint emits double-clicked before the second pointer-up. Folder
    // navigation rebuilds the list in between, so suppress that stale click.
    private property <bool> suppress-next-click: false;
    out property <bool> has-hover: touch.has-hover;
    callback clicked(bool);
    callback double-clicked;
    callback drag-started;

    folder-icon := Text {
        x: root.text-left-padding;
        width: 16px;
        height: parent.height;
        text: "\u{E8B7}";
        font-family: "Segoe MDL2 Assets";
        font-size: 14px;
        color: #FFC83D;
        horizontal-alignment: center;
        vertical-alignment: center;
        visible: root.is-folder;
    }

    executable-icon := Text {
        x: root.text-left-padding;
        width: 16px;
        height: parent.height;
        text: "\u{E171}";
        font-family: "Segoe MDL2 Assets";
        font-size: 14px;
        color: #E81123;
        horizontal-alignment: center;
        vertical-alignment: center;
        visible: root.is-executable;
    }

    archive-icon := Text {
        x: root.text-left-padding;
        width: 16px;
        height: parent.height;
        text: "\u{E118}";
        font-family: "Segoe MDL2 Assets";
        font-size: 14px;
        color: #107C10;
        horizontal-alignment: center;
        vertical-alignment: center;
        visible: root.is-archive;
    }

    cell-text := Text {
        x: root.is-folder || root.is-executable || root.is-archive
            ? root.text-left-padding + 20px : root.text-left-padding;
        width: max(0px, parent.width - self.x - root.text-right-padding);
        height: parent.height;
        text: root.value;
        color: root.selected ? Palette.selection-foreground : Palette.foreground;
        font-weight: root.emphasize ? 600 : 400;
        horizontal-alignment: root.right-aligned ? right : left;
        vertical-alignment: center;
        overflow: elide;
    }

    // This TouchArea is intentionally above the Text and is the tooltip's
    // hover owner.  The row-wide click area is underneath it, so text cells
    // retain selection/double-click behavior while still receiving hover.
    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: root.is-folder ? pointer : default;
        double-clicked => {
            if root.folder-activation {
                root.suppress-next-click = true;
            }
            root.double-clicked();
        }

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.drag-active = false;
                root.drag-start-x = self.mouse-x;
                root.drag-start-y = self.mouse-y;
            } else if (event.kind == PointerEventKind.move && self.pressed && !root.drag-active) {
                if (self.mouse-x > root.drag-start-x + 6px
                        || self.mouse-x < root.drag-start-x - 6px
                        || self.mouse-y > root.drag-start-y + 6px
                        || self.mouse-y < root.drag-start-y - 6px) {
                    root.drag-active = true;
                    root.drag-started();
                }
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                if (event.kind == PointerEventKind.up
                        && event.button == PointerEventButton.left
                        && !root.drag-active) {
                    if !root.suppress-next-click {
                        root.clicked(event.modifiers.shift);
                    }
                }
                root.suppress-next-click = false;
                root.drag-active = false;
            }
        }

        if cell-text.preferred-width > cell-text.width : Tooltip {
            text: @markdown("\{root.value}");
        }
    }
}

component ArchiveTableHeader inherits Rectangle {
    in property <float> initial-name-boundary: 0.28;
    in property <float> initial-size-boundary: 0.40;
    in property <float> initial-packed-boundary: 0.52;
    in property <int> sort-column: 0;
    in property <bool> sort-ascending: true;
    callback sort(int);
    callback column-widths-changed(float, float, float);

    private property <length> content-width: max(1px, self.width - 36px);
    private property <float> name-boundary: root.initial-name-boundary;
    private property <float> size-boundary: root.initial-size-boundary;
    private property <float> packed-boundary: root.initial-packed-boundary;
    private property <length> min-name-width: 96px;
    private property <length> min-size-width: 60px;
    private property <length> min-packed-width: 60px;
    private property <length> min-modified-width: 100px;

    out property <length> name-column-width: root.content-width * root.name-boundary;
    out property <length> size-column-width: root.content-width * (root.size-boundary - root.name-boundary);
    out property <length> packed-column-width: root.content-width * (root.packed-boundary - root.size-boundary);
    out property <length> modified-column-width: root.content-width * (1.0 - root.packed-boundary);

    height: 30px;
    background: Palette.alternate-background;

    Rectangle {
        x: 0px;
        width: 36px;
        height: parent.height;
        background: Palette.alternate-background;
    }

    HeaderCell {
        x: 36px;
        column-width: root.name-column-width;
        height: parent.height;
        label: "Name";
        column-index: 0;
        sorted: root.sort-column == 0;
        sort-ascending: root.sort-ascending;
        sort(column) => { root.sort(column); }
        resize(column, width) => {
            if (column == 0) {
                root.name-boundary = clamp(
                    width / root.content-width,
                    root.min-name-width / root.content-width,
                    root.size-boundary - root.min-size-width / root.content-width
                );
            }
        }
        resize-finished(column) => {
            root.column-widths-changed(
                root.name-boundary,
                root.size-boundary,
                root.packed-boundary
            );
        }
    }

    HeaderCell {
        x: 36px + root.name-column-width;
        column-width: root.size-column-width;
        height: parent.height;
        label: "Size";
        column-index: 1;
        sorted: root.sort-column == 1;
        sort-ascending: root.sort-ascending;
        sort(column) => { root.sort(column); }
        resize(column, width) => {
            if (column == 1) {
                root.size-boundary = clamp(
                    root.name-boundary + width / root.content-width,
                    root.name-boundary + root.min-size-width / root.content-width,
                    root.packed-boundary - root.min-packed-width / root.content-width
                );
            }
        }
        resize-finished(column) => {
            root.column-widths-changed(
                root.name-boundary,
                root.size-boundary,
                root.packed-boundary
            );
        }
    }

    HeaderCell {
        x: 36px + root.size-column-width + root.name-column-width;
        column-width: root.packed-column-width;
        height: parent.height;
        label: "Packed";
        column-index: 2;
        sorted: root.sort-column == 2;
        sort-ascending: root.sort-ascending;
        sort(column) => { root.sort(column); }
        resize(column, width) => {
            if (column == 2) {
                root.packed-boundary = clamp(
                    root.size-boundary + width / root.content-width,
                    root.size-boundary + root.min-packed-width / root.content-width,
                    1.0 - root.min-modified-width / root.content-width
                );
            }
        }
        resize-finished(column) => {
            root.column-widths-changed(
                root.name-boundary,
                root.size-boundary,
                root.packed-boundary
            );
        }
    }

    HeaderCell {
        x: 36px + root.packed-column-width + root.size-column-width + root.name-column-width;
        column-width: root.modified-column-width;
        height: parent.height;
        label: "Modified";
        column-index: 3;
        sorted: root.sort-column == 3;
        sort-ascending: root.sort-ascending;
        resizable: false;
        sort(column) => { root.sort(column); }
    }
}

component ArchiveListRow inherits Rectangle {
    in property <ArchiveRow> entry;
    in property <int> row-index;
    in property <int> language-index;
    in property <length> name-column-width;
    in property <length> size-column-width;
    in property <length> packed-column-width;
    in property <length> modified-column-width;
    in property <bool> context-menu-enabled: true;
    // A folder double-click rebuilds the model before the second pointer-up.
    private property <bool> suppress-next-click: false;
    callback toggle(int, bool);
    callback activate(int);
    callback extract-context(int);
    callback drag-started(int);

    height: 28px;
    background: root.entry.selected ? Palette.selection-background
        : row-pointer.has-hover || name-cell.has-hover || size-cell.has-hover
            || packed-cell.has-hover || modified-cell.has-hover
                ? Palette.control-background : transparent;
    border-radius: 6px;
    accessible-role: list-item;
    accessible-label: root.entry.name;
    accessible-item-selectable: true;
    accessible-item-selected: root.entry.selected;
    accessible-item-index: root.row-index;

    CheckBox {
        x: 6px;
        y: 1px;
        width: 24px;
        height: parent.height - 2px;
        checked: root.entry.selected;
        text: "";
        toggled => { root.toggle(root.row-index, false); }
    }

    row-pointer := TouchArea {
        x: 36px;
        width: parent.width - 36px;
        height: parent.height;
        mouse-cursor: root.entry.is-folder ? pointer : default;
        double-clicked => {
            if root.entry.is-folder {
                root.suppress-next-click = true;
            }
            root.activate(root.row-index);
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                if !root.suppress-next-click {
                    root.toggle(root.row-index, event.modifiers.shift);
                }
                root.suppress-next-click = false;
            } else if event.kind == PointerEventKind.cancel {
                root.suppress-next-click = false;
            }
        }
    }

    name-cell := ArchiveTextCell {
        x: 36px;
        width: root.name-column-width;
        height: parent.height;
        value: root.entry.name;
        selected: root.entry.selected;
        is-folder: root.entry.is-folder;
        is-executable: root.entry.is-executable;
        is-archive: root.entry.is-archive;
        folder-activation: root.entry.is-folder;
        emphasize: root.entry.is-folder;
        text-left-padding: 4px;
        text-right-padding: 0px;
        clicked(shift) => { root.toggle(root.row-index, shift); }
        double-clicked => { root.activate(root.row-index); }
        drag-started => { root.drag-started(root.row-index); }
    }

    size-cell := ArchiveTextCell {
        x: 36px + root.name-column-width;
        width: root.size-column-width;
        height: parent.height;
        value: root.entry.size;
        selected: root.entry.selected;
        folder-activation: root.entry.is-folder;
        right-aligned: true;
        text-left-padding: 6px;
        text-right-padding: 6px;
        clicked(shift) => { root.toggle(root.row-index, shift); }
        double-clicked => { root.activate(root.row-index); }
        drag-started => { root.drag-started(root.row-index); }
    }

    packed-cell := ArchiveTextCell {
        x: 36px + root.name-column-width + root.size-column-width;
        width: root.packed-column-width;
        height: parent.height;
        value: root.entry.packed;
        selected: root.entry.selected;
        folder-activation: root.entry.is-folder;
        right-aligned: true;
        text-left-padding: 6px;
        text-right-padding: 6px;
        clicked(shift) => { root.toggle(root.row-index, shift); }
        double-clicked => { root.activate(root.row-index); }
        drag-started => { root.drag-started(root.row-index); }
    }

    modified-cell := ArchiveTextCell {
        x: 36px + root.name-column-width + root.size-column-width + root.packed-column-width;
        width: root.modified-column-width;
        height: parent.height;
        value: root.entry.modified;
        selected: root.entry.selected;
        folder-activation: root.entry.is-folder;
        text-left-padding: 8px;
        text-right-padding: 8px;
        clicked(shift) => { root.toggle(root.row-index, shift); }
        double-clicked => { root.activate(root.row-index); }
        drag-started => { root.drag-started(root.row-index); }
    }

    context-menu := ContextMenuArea {
        width: parent.width;
        height: parent.height;
        enabled: root.context-menu-enabled;

        Menu {
            MenuItem {
                title: root.language-index == 1
                    ? "선택 항목 압축 풀기…"
                    : root.language-index == 2
                        ? "選択項目を展開…"
                        : "Extract selected item(s)…";
                activated => { root.extract-context(root.row-index); }
            }
        }
    }
}

component IconToolButton inherits Rectangle {
    in property <string> glyph;
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    callback clicked;

    width: 38px;
    height: 38px;
    border-radius: 9px;
    // Ghost controls stay transparent at rest; hover/focus uses a very light
    // black wash so the affordance feels slightly darker, never brighter.
    background: !root.enabled ? transparent
        : touch.has-hover ? #00000012 : transparent;
    border-width: 0px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }

        if root.icon.width > 0 && root.icon.height > 0 : Image {
            source: root.icon;
            width: 19px;
            height: 19px;
            colorize: root.enabled
                ? (root.primary ? Palette.accent-background : Palette.foreground)
                : Palette.foreground;
            opacity: root.enabled ? 1.0 : 0.38;
        }

        if root.icon.width == 0 || root.icon.height == 0 : Text {
            text: root.glyph;
            font-family: "Segoe MDL2 Assets";
            font-size: 19px;
            color: root.enabled ? (root.primary ? Palette.accent-background : Palette.foreground) : Palette.foreground;
            opacity: root.enabled ? 1.0 : 0.38;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Tooltip {
            text: @markdown("\{root.label}");
        }
    }
}

export component AppWindow inherits Window {
    in-out property <[ArchiveRow]> archive-rows;
    in-out property <string> archive-title;
    in-out property <string> current-folder;
    in-out property <string> status-text;
    in-out property <string> summary-text;
    in-out property <string> libarchive-version;
    in-out property <string> app-version;
    in-out property <bool> has-archive;
    in-out property <bool> busy;
    in-out property <bool> can-go-up;

    in-out property <bool> conflict-visible;
    in-out property <string> conflict-path;

    in-out property <bool> create-visible;
    in-out property <string> create-source-summary;
    in-out property <string> create-destination;
    in-out property <[string]> create-formats;
    in-out property <bool> create-has-sources;
    in-out property <int> create-thread-selection: 0;
    in-out property <int> create-volume-selection: 0;
    in-out property <bool> create-header-encryption: false;

    in-out property <bool> password-visible;
    in-out property <string> password-operation;
    in-out property <string> password-value;

    in-out property <string> font-family;
    in-out property <[string]> font-options;
    in-out property <int> font-selection;
    in-out property <int> settings-thread-selection: 0;
    in-out property <bool> settings-header-encryption: false;
    in-out property <bool> esc-close-main-window: false;
    in-out property <int> theme-selection: 0;
    in-out property <[string]> language-options;
    in-out property <int> language-selection: 0;
    in-out property <int> language-preference-selection: 0;
    in-out property <[string]> encoding-options;
    in-out property <int> encoding-selection: 0;
    in-out property <int> selection-state: 0;
    in-out property <int> selection-count: 0;
    in-out property <bool> settings-visible;
    in-out property <string> context-menu-state;
    in-out property <bool> context-menu-managed-by-package;
    in-out property <int> sort-column: 0;
    in-out property <bool> sort-ascending: true;
    in-out property <float> column-name-boundary: 0.28;
    in-out property <float> column-size-boundary: 0.40;
    in-out property <float> column-packed-boundary: 0.52;

    callback open-requested();
    callback close-archive-requested();
    callback up-requested();
    callback toggle-selection(int, bool);
    callback select-all-requested(bool);
    callback activate-row(int);
    callback extract-context-requested(int);
    callback drag-row-requested(int);
    callback sort-requested(int);
    callback encoding-selection-changed(int);
    callback show-extract-requested();
    callback extract-requested(int, int, string, bool);
    callback prepare-create-requested();
    callback choose-create-files-requested();
    callback choose-create-folder-requested();
    callback create-requested(int, int, int, int, string, string, bool);
    callback test-requested();
    callback cancel-requested();
    callback conflict-response(int);
    callback password-response(string, bool);
    callback dropped(data-transfer);

    callback settings-requested();
    callback settings-applied(int, int, int, int, bool, bool);
    callback main-window-close-requested();
    callback settings-cancelled();
    callback github-requested();
    callback third-party-notices-requested();
    callback third-party-licenses-requested();
    callback column-widths-changed(float, float, float);
    callback context-menu-register-requested();
    callback context-menu-unregister-requested();
    callback file-associations-register-requested();
    callback file-associations-unregister-requested();
    callback default-apps-requested();

    in-out property <bool> extract-visible: false;
    in-out property <bool> extract-selected-only: false;

    title: root.archive-title == "" ? "ArchiveRclick" : root.archive-title + " — ArchiveRclick";
    icon: @image-url("../app.png");
    default-font-family: root.font-family == "" ? "Yu Gothic" : root.font-family;
    preferred-width: 1040px;
    preferred-height: 600px;
    // Keep the compact layout usable on narrow screens.  The flexible path
    // field yields first, while the fixed controls remain accessible.
    min-width: 520px;
    min-height: 400px;
    background: Palette.background;

    // Theme selection: 0 = follow the system, 1 = light, 2 = dark.
    changed theme-selection => {
        Palette.color-scheme = root.theme-selection == 1 ? ColorScheme.light
            : root.theme-selection == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }

    forward-focus: shortcuts;
    shortcuts := FocusScope {
        width: parent.width;
        height: parent.height;
        focus-on-click: false;

        KeyBinding {
            keys: @keys(Control + O);
            enabled: !root.busy;
            activated => { root.open-requested(); }
        }

        KeyBinding {
            keys: @keys(Alt + LeftArrow);
            enabled: root.can-go-up && !root.busy;
            activated => { root.up-requested(); }
        }

        KeyBinding {
            keys: @keys(Escape);
            activated => {
                if (root.settings-visible) {
                    root.settings-visible = false;
                } else if (root.create-visible) {
                    root.create-visible = false;
                } else if (root.extract-visible) {
                    root.extract-visible = false;
                } else if (root.conflict-visible) {
                    root.conflict-response(4);
                } else if (root.busy) {
                    // Do not cancel or close an archive operation with Escape.
                } else if (root.esc-close-main-window) {
                    root.main-window-close-requested();
                }
            }
        }

        drop-target := DropArea {
            width: parent.width;
            height: parent.height;

            can-drop(event) => {
                return root.busy || root.password-visible || root.conflict-visible || root.create-visible || root.extract-visible || root.settings-visible ? DragAction.none : DragAction.copy;
            }

            dropped(event) => {
                if (root.busy || root.password-visible || root.conflict-visible || root.create-visible || root.extract-visible || root.settings-visible) {
                    return DragAction.none;
                }
                root.dropped(event.data);
                return DragAction.copy;
            }

            VerticalLayout {
                width: parent.width;
                height: parent.height;
                spacing: 0px;

                // ---------------- Compact icon toolbar ----------------
                Rectangle {
                    height: 48px;
                    background: Palette.background;
                    // A soft shadow creates a lighter visual break than a
                    // full-width border while keeping the toolbar compact.
                    drop-shadow-blur: 10px;
                    drop-shadow-color: #00000012;
                    drop-shadow-offset-y: 2px;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 5px;
                        padding-bottom: 5px;
                        spacing: 8px;

                        IconToolButton {
                            glyph: "\u{E838}";
                            icon: @image-url("folder-open.svg");
                            label: root.language-selection == 1 ? "열기" : root.language-selection == 2 ? "開く" : "Open";
                            enabled: !root.busy;
                            clicked => { root.open-requested(); }
                        }

                        IconToolButton {
                            glyph: "\u{E8BB}";
                            label: root.language-selection == 1 ? "압축파일 닫기" : root.language-selection == 2 ? "アーカイブを閉じる" : "Close archive";
                            enabled: root.has-archive && !root.busy && !root.password-visible;
                            clicked => { root.close-archive-requested(); }
                        }

                        IconToolButton {
                            glyph: "\u{E896}";
                            label: root.language-selection == 1 ? "압축 풀기" : root.language-selection == 2 ? "展開" : "Extract";
                            enabled: root.has-archive && !root.busy;
                            clicked => {
                                root.extract-selected-only = false;
                                root.show-extract-requested();
                                root.extract-visible = true;
                            }
                        }

                        IconToolButton {
                            glyph: "\u{E109}";
                            label: root.language-selection == 1 ? "압축하기" : root.language-selection == 2 ? "圧縮" : "Compress";
                            enabled: !root.busy;
                            clicked => { root.prepare-create-requested(); }
                        }

                        Rectangle { horizontal-stretch: 1; }

                        IconToolButton {
                            glyph: "\u{E713}";
                            label: root.language-selection == 1 ? "설정" : root.language-selection == 2 ? "設定" : "Settings";
                            enabled: !root.busy;
                            clicked => { root.settings-requested(); }
                        }
                    }
                }

                // Thin divider separating the icon toolbar from the
                // path bar below.
                Rectangle {
                    height: 1px;
                    background: AppTheme.border;
                }

                // ---------------- Path bar ----------------
                Rectangle {
                    height: 42px;
                    background: Palette.background;
                    // Keep this surface visually connected to the toolbar;
                    // the rounded path field below provides the actual
                    // control boundary.
                    drop-shadow-blur: 8px;
                    drop-shadow-color: #0000000a;
                    drop-shadow-offset-y: 1px;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 4px;
                        padding-bottom: 4px;
                        spacing: 8px;

                        IconToolButton {
                            width: 34px;
                            height: 34px;
                            glyph: "\u{E74A}";
                            label: root.language-selection == 1 ? "위로" : root.language-selection == 2 ? "上へ" : "Up";
                            enabled: root.can-go-up && !root.busy;
                            clicked => { root.up-requested(); }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 8px;
                            background: Palette.control-background;
                            border-width: 1px;
                            border-color: AppTheme.border;
                            clip: true;

                            folder-path-text := Text {
                                x: 12px;
                                width: parent.width - 24px;
                                height: parent.height;
                                text: root.has-archive
                                    ? (root.current-folder == "" ? "/" : root.current-folder)
                                    : (root.language-selection == 1 ? "열린 압축파일 없음" : root.language-selection == 2 ? "アーカイブ未選択" : "No archive open");
                                color: Palette.foreground;
                                font-size: 13px;
                                vertical-alignment: center;
                                overflow: elide;

                                if root.has-archive && root.current-folder != "" : Tooltip {
                                    text: @markdown("\{root.current-folder}");
                                }
                            }
                        }

                        Text {
                            text: "Code page";
                            width: 62px;
                            color: Palette.foreground;
                            opacity: 0.72;
                            font-size: 11px;
                            vertical-alignment: center;
                        }

                        CodePageComboBox {
                            width: 180px;
                            model: root.encoding-options;
                            current-index: root.encoding-selection;
                            selection-changed(index) => {
                                root.encoding-selection = self.current-index;
                                root.encoding-selection-changed(index);
                            }
                        }

                    }
                }

                // ---------------- Archive contents ----------------
                if root.has-archive : Rectangle {
                    vertical-stretch: 1;
                    background: Palette.background;

                    VerticalLayout {
                        spacing: 6px;
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 8px;
                        padding-bottom: 2px;

                        HorizontalLayout {
                            height: 28px;
                            spacing: 8px;

                            CheckBox {
                                text: root.language-selection == 1 ? "전체 선택" : root.language-selection == 2 ? "すべて選択" : "Select all";
                                checked: root.selection-state == 2;
                                enabled: root.archive-rows.length > 0 && !root.busy;
                                toggled => { root.select-all-requested(self.checked); }
                            }

                            Text {
                                text: root.selection-count > 0
                                    ? (root.language-selection == 1 ? "" + root.selection-count + "개 항목 선택" : root.language-selection == 2 ? "" + root.selection-count + "項目を選択中" : "" + root.selection-count + " items selected")
                                    : "";
                                color: Palette.foreground;
                                opacity: 0.68;
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            Rectangle { horizontal-stretch: 1; }

                            IconToolButton {
                                width: 28px;
                                height: 28px;
                                glyph: "\u{E711}";
                                label: root.language-selection == 1 ? "선택 해제" : root.language-selection == 2 ? "選択解除" : "Clear selection";
                                enabled: root.selection-state != 0 && !root.busy;
                                clicked => { root.select-all-requested(false); }
                            }
                        }

                        Rectangle {
                            vertical-stretch: 1;
                            background: Palette.background;
                            clip: true;

                            VerticalLayout {
                                spacing: 0px;

                                archive-header := ArchiveTableHeader {
                                    initial-name-boundary: root.column-name-boundary;
                                    initial-size-boundary: root.column-size-boundary;
                                    initial-packed-boundary: root.column-packed-boundary;
                                    sort-column: root.sort-column;
                                    sort-ascending: root.sort-ascending;
                                    sort(column) => { root.sort-requested(column); }
                                    column-widths-changed(name, size, packed) => {
                                        root.column-name-boundary = name;
                                        root.column-size-boundary = size;
                                        root.column-packed-boundary = packed;
                                        root.column-widths-changed(name, size, packed);
                                    }
                                }

                                ListView {
                                    vertical-stretch: 1;
                                    accessible-role: list;
                                    accessible-label: root.language-selection == 1 ? "압축파일 내용" : root.language-selection == 2 ? "アーカイブの内容" : "Archive contents";
                                    accessible-item-count: root.archive-rows.length;

                                    for row[index] in root.archive-rows : ArchiveListRow {
                                        entry: row;
                                        row-index: index;
                                        language-index: root.language-selection;
                                        name-column-width: archive-header.name-column-width;
                                        size-column-width: archive-header.size-column-width;
                                        packed-column-width: archive-header.packed-column-width;
                                        modified-column-width: archive-header.modified-column-width;
                                        context-menu-enabled: !root.busy;
                                        toggle(row-index, shift) => { root.toggle-selection(row-index, shift); }
                                        activate(row-index) => { root.activate-row(row-index); }
                                        extract-context(row-index) => { root.extract-context-requested(row-index); }
                                        drag-started(row-index) => { root.drag-row-requested(row-index); }
                                    }
                                }
                            }
                        }
                    }
                }

                // ---------------- Empty state ----------------
                if !root.has-archive : Rectangle {
                    vertical-stretch: 1;
                    background: Palette.background;

                    VerticalLayout {
                        alignment: center;
                        spacing: 10px;
                        padding: 20px;

                        Text {
                            text: drop-target.has-drag
                                ? (root.language-selection == 1 ? "놓아서 열기" : root.language-selection == 2 ? "ドロップして開く" : "Release to open")
                                : (root.language-selection == 1 ? "압축파일을 열어 내용을 확인하세요" : root.language-selection == 2 ? "アーカイブを開いて内容を確認" : "Open an archive to inspect its contents");
                            color: Palette.foreground;
                            font-size: 19px;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: root.language-selection == 1
                                ? "열기, Ctrl+O, 명령줄 경로 또는 압축파일을 이곳에 끌어다 놓으세요."
                                : root.language-selection == 2
                                    ? "開く、Ctrl+O、コマンドラインパス、またはここへアーカイブをドロップしてください。"
                                    : "Use Open, Ctrl+O, a command-line path, or drag an archive here.";
                            color: Palette.foreground;
                            font-size: 12px;
                            opacity: 0.7;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            alignment: center;

                            Button {
                                width: 180px;
                                icon: @image-url("folder-open.svg");
                                icon-size: 18px;
                                colorize-icon: true;
                                text: root.language-selection == 1 ? "압축파일 열기…" : root.language-selection == 2 ? "アーカイブを開く…" : "Open archive…";
                                primary: true;
                                enabled: !root.busy;
                                clicked => { root.open-requested(); }
                            }
                        }
                    }
                }

                // ---------------- Status bar ----------------
                Rectangle {
                    height: 1px;
                    background: AppTheme.border;
                }

                Rectangle {
                    height: 32px;
                    background: Palette.background;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 8px;

                        Text {
                            text: root.summary-text;
                            color: Palette.foreground;
                            font-size: 11px;
                            font-weight: 500;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        Rectangle { horizontal-stretch: 1; }

                        Text {
                            text: root.libarchive-version;
                            color: Palette.foreground;
                            font-size: 11px;
                            opacity: 0.7;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }

    if root.extract-visible : ExtractOverlay {
        language-index: root.language-selection;
        archive-name: root.archive-title;
        selected-only-default: root.extract-selected-only;
        accepted(destination-mode, conflict-policy, password, selected-only) => {
            root.extract-visible = false;
            root.extract-selected-only = false;
            root.extract-requested(destination-mode, conflict-policy, password, selected-only);
        }
        cancelled => {
            root.extract-visible = false;
            root.extract-selected-only = false;
        }
    }

    if root.create-visible : CreateOverlay {
        language-index: root.language-selection;
        source-summary: root.create-source-summary;
        destination: root.create-destination;
        available-formats: root.create-formats;
        has-sources: root.create-has-sources;
        thread-selection: root.create-thread-selection;
        volume-selection: root.create-volume-selection;
        header-encryption-default: root.create-header-encryption;
        choose-files => { root.choose-create-files-requested(); }
        choose-folder => { root.choose-create-folder-requested(); }
        accepted(format-index, level, thread-index, volume-index, password, password-confirmation, encrypt-headers) => {
            root.create-visible = false;
            root.create-requested(format-index, level, thread-index, volume-index, password, password-confirmation, encrypt-headers);
        }
        cancelled => { root.create-visible = false; }
    }

    if root.conflict-visible : ConflictOverlay {
        conflict-path: root.conflict-path;
        responded(response) => { root.conflict-response(response); }
    }

    if root.settings-visible : SettingsOverlay {
        app-version: root.app-version;
        font-options: root.font-options;
        font-selection: root.font-selection;
        thread-selection: root.settings-thread-selection;
        header-encryption: root.settings-header-encryption;
        theme-selection: root.theme-selection;
        esc-close-main-window: root.esc-close-main-window;
        language-options: root.language-options;
        language-selection: root.language-selection;
        language-preference-selection: root.language-preference-selection;
        context-menu-state: root.context-menu-state;
        context-menu-managed-by-package: root.context-menu-managed-by-package;
        register-context-menu => { root.context-menu-register-requested(); }
        unregister-context-menu => { root.context-menu-unregister-requested(); }
        register-file-associations => { root.file-associations-register-requested(); }
        unregister-file-associations => { root.file-associations-unregister-requested(); }
        open-default-apps => { root.default-apps-requested(); }
        open-github => { root.github-requested(); }
        open-third-party-notices => { root.third-party-notices-requested(); }
        open-third-party-licenses => { root.third-party-licenses-requested(); }
        accepted(font-selection, thread-index, theme-index, language-index, header_encryption, esc_close_main_window) => {
            root.settings-visible = false;
            root.settings-applied(font-selection, thread-index, theme-index, language-index, header_encryption, esc_close_main_window);
        }
        cancelled => { root.settings-visible = false; }
    }

    if root.password-visible : Rectangle {
        background: #00000094;
        accessible-role: region;
        accessible-label: root.language-selection == 1 ? "압축파일 암호" : root.language-selection == 2 ? "アーカイブのパスワード" : "Archive password";

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 440px;
            height: 220px;
            background: Palette.background;
            border-width: 1px;
            border-color: AppTheme.border;
            border-radius: 12px;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000055;
            drop-shadow-offset-y: 6px;

            VerticalLayout {
                padding: 18px;
                spacing: 10px;

                Text {
                    text: root.language-selection == 1 ? "암호 필요" : root.language-selection == 2 ? "パスワードが必要です" : "Password required";
                    font-size: 20px;
                    font-weight: 600;
                    color: Palette.foreground;
                }

                Text {
                    text: root.password-operation;
                    color: Palette.foreground;
                    wrap: word-wrap;
                }

                password-entry := LineEdit {
                    input-type: InputType.password;
                    text <=> root.password-value;
                    placeholder-text: root.language-selection == 1 ? "압축파일 암호" : root.language-selection == 2 ? "アーカイブのパスワード" : "Archive password";
                    enabled: true;
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: root.language-selection == 1 ? "취소" : root.language-selection == 2 ? "キャンセル" : "Cancel";
                        clicked => { root.password-response("", false); }
                    }
                    Button {
                        text: root.language-selection == 1 ? "계속" : root.language-selection == 2 ? "続行" : "Continue";
                        primary: true;
                        enabled: password-entry.text != "";
                        clicked => { root.password-response(password-entry.text, true); }
                    }
                }
            }
        }
    }
}
