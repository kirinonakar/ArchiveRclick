import { Button, Palette } from "std-widgets.slint";
import { AppTheme } from "theme.slint";

// The progress bar gives a quick visual indication; this row keeps the exact
// values readable while an Explorer operation is running.
export component ProgressStats inherits Rectangle {
    in property <string> percent-text;
    in property <string> elapsed-text;
    in property <string> remaining-text;
    in property <string> total-text;

    height: 30px;
    background: Palette.alternate-background;
    border-radius: 6px;
    accessible-role: region;
    accessible-label: "Operation timing";

    HorizontalLayout {
        padding: 6px;
        spacing: 8px;

        Text {
            text: root.percent-text;
            color: Palette.foreground;
            font-weight: 600;
            horizontal-stretch: 1;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            text: root.elapsed-text;
            color: Palette.foreground;
            horizontal-stretch: 2;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            text: root.remaining-text;
            color: Palette.foreground;
            horizontal-stretch: 2;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            text: root.total-text;
            color: Palette.foreground;
            horizontal-stretch: 2;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component ConflictOverlay inherits Rectangle {
    in property <string> conflict-path;

    callback responded(int);

    background: #00000094;
    accessible-role: region;
    accessible-label: "Existing file conflict";

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 650px;
        height: 228px;
        background: Palette.background;
        border-width: 1px;
        border-color: AppTheme.border;
        border-radius: 6px;

        VerticalLayout {
            padding: 18px;
            spacing: 10px;

            Text {
                text: "A file already exists";
                font-size: 19px;
                font-weight: 600;
                color: Palette.foreground;
            }

            Text {
                text: root.conflict-path;
                color: Palette.foreground;
                wrap: word-wrap;
            }

            Text {
                text: "Choose how ArchiveRclick should continue.";
                color: Palette.foreground;
            }

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                spacing: 6px;

                Button {
                    text: "Overwrite";
                    primary: true;
                    clicked => { root.responded(0); }
                }

                Button {
                    text: "Skip";
                    clicked => { root.responded(1); }
                }

                Button {
                    text: "Overwrite all";
                    clicked => { root.responded(2); }
                }

                Button {
                    text: "Skip all";
                    clicked => { root.responded(3); }
                }

                Rectangle { horizontal-stretch: 1; }

                Button {
                    text: "Cancel";
                    clicked => { root.responded(4); }
                }
            }
        }
    }
}
