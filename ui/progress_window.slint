import { Button, LineEdit, Palette, ProgressIndicator } from "std-widgets.slint";
import { AppTheme } from "theme.slint";
import { ProgressStats } from "progress.slint";

// Small progress-only window shown while Explorer right-click operations run.
// Unlike the main window it has no archive browser UI; the app closes it by
// itself (hide + quit_event_loop) once the operation is finished.
export component ProgressWindow inherits Window {
    in-out property <string> font-family;
    in-out property <int> theme-selection: 0;
    in-out property <string> progress-title;
    in-out property <string> progress-file;
    in-out property <string> progress-file-percent;
    in-out property <string> progress-percent;
    in-out property <string> progress-elapsed;
    in-out property <string> progress-remaining;
    in-out property <string> progress-total;
    in-out property <string> progress-detail;
    in-out property <float> progress-file-value;
    in-out property <float> progress-value;
    in-out property <bool> password-visible;
    in-out property <string> password-operation;
    in-out property <string> password-value;

    callback cancel-requested();
    callback password-response(string, bool);

    title: "ArchiveRclick";
    icon: @image-url("../app.png");
    default-font-family: root.font-family == "" ? "Yu Gothic" : root.font-family;
    preferred-width: 600px;
    preferred-height: 280px;
    min-width: 540px;
    min-height: 280px;
    background: Palette.background;

    // Theme selection: 0 = follow the system, 1 = light, 2 = dark.
    changed theme-selection => {
        Palette.color-scheme = root.theme-selection == 1 ? ColorScheme.light
            : root.theme-selection == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        Text {
            text: root.progress-title;
            font-size: 19px;
            font-weight: 600;
            color: Palette.foreground;
            overflow: elide;
        }

        Text {
            text: root.progress-file;
            color: Palette.foreground;
            overflow: elide;
        }

        HorizontalLayout {
            height: 24px;
            spacing: 8px;

            Text {
                text: "File";
                width: 58px;
                color: Palette.foreground;
                vertical-alignment: center;
            }

            ProgressIndicator {
                progress: root.progress-file-value;
                indeterminate: root.progress-file-value < 0;
                horizontal-stretch: 1;
                accessible-label: "Current file progress";
                accessible-value: root.progress-file-value < 0 ? "Working" : "" + Math.round(root.progress-file-value * 100) + "%";
            }

            Text {
                text: root.progress-file-percent;
                width: 48px;
                color: Palette.foreground;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            height: 24px;
            spacing: 8px;

            Text {
                text: "Overall";
                width: 58px;
                color: Palette.foreground;
                vertical-alignment: center;
            }

            ProgressIndicator {
                progress: root.progress-value;
                indeterminate: root.progress-value < 0;
                horizontal-stretch: 1;
                accessible-label: "Overall operation progress";
                accessible-value: root.progress-value < 0 ? "Working" : "" + Math.round(root.progress-value * 100) + "%";
            }

            Text {
                text: root.progress-percent;
                width: 48px;
                color: Palette.foreground;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }

        ProgressStats {
            percent-text: root.progress-percent;
            elapsed-text: root.progress-elapsed;
            remaining-text: root.progress-remaining;
            total-text: root.progress-total;
        }

        Text {
            text: root.progress-detail;
            color: Palette.foreground;
            wrap: word-wrap;
            vertical-alignment: center;
            min-height: 24px;
        }

        // Keep the Cancel button close to the content instead of pinning it
        // to the bottom of the window.
        Rectangle { height: 12px; }

        HorizontalLayout {
            Rectangle { horizontal-stretch: 1; }

            Button {
                text: "Cancel";
                clicked => { root.cancel-requested(); }
            }
        }
    }

    if root.password-visible : Rectangle {
        background: #00000094;
        accessible-role: region;
        accessible-label: "Archive password";

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 440px;
            height: 220px;
            background: Palette.background;
            border-width: 1px;
            border-color: AppTheme.border;
            border-radius: 12px;
            drop-shadow-blur: 18px;
            drop-shadow-color: #00000055;
            drop-shadow-offset-y: 6px;

            VerticalLayout {
                padding: 18px;
                spacing: 10px;

                Text {
                    text: "Password required";
                    font-size: 20px;
                    font-weight: 600;
                    color: Palette.foreground;
                }

                Text {
                    text: root.password-operation;
                    color: Palette.foreground;
                    wrap: word-wrap;
                }

                password-entry := LineEdit {
                    input-type: InputType.password;
                    text <=> root.password-value;
                    placeholder-text: "Archive password";
                    enabled: true;
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }

                    Button {
                        text: "Cancel";
                        clicked => { root.password-response("", false); }
                    }

                    Button {
                        text: "Continue";
                        primary: true;
                        enabled: password-entry.text != "";
                        clicked => { root.password-response(password-entry.text, true); }
                    }
                }
            }
        }
    }
}
