import {
    Button,
    CheckBox,
    ComboBox,
    LineEdit,
    Palette,
    SpinBox
} from "std-widgets.slint";
import { AppTheme } from "theme.slint";

export component ExtractOverlay inherits Rectangle {
    in property <int> language-index;
    in property <string> archive-name;
    in property <bool> selected-only-default: false;

    callback accepted(int, int, string, bool);
    callback cancelled();

    background: #00000080;
    accessible-role: region;
    accessible-label: root.language-index == 1 ? "압축 풀기" : root.language-index == 2 ? "アーカイブを展開" : "Extract archive";

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 480px;
        height: 360px;
        background: Palette.background;
        border-width: 1px;
        border-color: AppTheme.border;
        border-radius: 12px;
        drop-shadow-blur: 22px;
        drop-shadow-color: #00000055;
        drop-shadow-offset-y: 6px;

        VerticalLayout {
            padding: 18px;
            spacing: 8px;

            Text {
                text: root.language-index == 1 ? "압축 풀기" : root.language-index == 2 ? "展開" : "Extract";
                font-size: 21px;
                font-weight: 700;
                color: Palette.foreground;
            }

            Text {
                text: root.archive-name;
                color: Palette.foreground;
                opacity: 0.72;
                overflow: elide;
            }

            Text {
                text: root.language-index == 1 ? "대상 폴더" : root.language-index == 2 ? "展開先" : "Destination";
                color: Palette.foreground;
                font-weight: 600;
            }

            destination := ComboBox {
                model: root.language-index == 1
                    ? ["폴더 선택…", "현재 폴더", "압축파일 이름 폴더"]
                    : root.language-index == 2
                        ? ["フォルダーを選択…", "現在のフォルダー", "アーカイブ名フォルダー"]
                        : ["Choose a directory…", "Current directory", "Archive-name directory"];
                current-index: 2;
            }

            Text {
                text: root.language-index == 1 ? "기존 파일" : root.language-index == 2 ? "既存ファイル" : "Existing files";
                color: Palette.foreground;
                font-weight: 600;
            }

            conflict-policy := ComboBox {
                model: root.language-index == 1
                    ? ["충돌마다 묻기", "덮어쓰기", "건너뛰기"]
                    : root.language-index == 2
                        ? ["毎回確認", "上書き", "スキップ"]
                        : ["Ask for each conflict", "Overwrite", "Skip"];
                current-index: 0;
            }

            HorizontalLayout {
                spacing: 8px;

                password := LineEdit {
                    horizontal-stretch: 1;
                    input-type: InputType.password;
                    placeholder-text: root.language-index == 1 ? "필요할 때만 암호 입력" : root.language-index == 2 ? "必要な場合のみ入力" : "Leave empty when not needed";
                }

                selected-only := CheckBox {
                    text: root.language-index == 1 ? "선택 항목만" : root.language-index == 2 ? "選択項目のみ" : "Selected only";
                    checked: root.selected-only-default;
                }
            }

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                spacing: 8px;

                Rectangle { horizontal-stretch: 1; }

                Button {
                    text: root.language-index == 1 ? "취소" : root.language-index == 2 ? "キャンセル" : "Cancel";
                    clicked => { root.cancelled(); }
                }

                Button {
                    text: root.language-index == 1 ? "압축 풀기" : root.language-index == 2 ? "展開" : "Extract";
                    primary: true;
                    clicked => {
                        root.accepted(
                            destination.current-index,
                            conflict-policy.current-index,
                            password.text,
                            selected-only.checked
                        );
                    }
                }
            }
        }
    }
}

export component CreateOverlay inherits Rectangle {
    in property <int> language-index;
    in property <string> source-summary;
    in property <[string]> available-formats;
    in property <bool> has-sources;
    in property <int> thread-selection;
    in property <int> volume-selection;
    in property <bool> header-encryption-default: false;

    private property <int> thread-index: root.thread-selection;
    private property <int> volume-index: root.volume-selection;
    private property <string> volume-custom-text;
    private property <bool> show-volume-custom:
        (format.current-value == "ZIP" || format.current-value == "7z")
        && volume-picker.current-value == root.volume-custom-label;
    private property <string> volume-custom-label:
        root.language-index == 1 ? "사용자 지정…" : root.language-index == 2 ? "カスタム…" : "Custom…";
    private property <string> password-error: "";

    callback accepted(int, int, int, int, string, string, string, bool);
    callback cancelled();
    callback choose-files();
    callback choose-folder();

    background: #00000080;
    accessible-role: region;
    accessible-label: root.language-index == 1 ? "압축파일 만들기" : root.language-index == 2 ? "アーカイブを作成" : "Create archive";

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 420px;
        height: root.show-volume-custom ? 376px : 340px;
        background: Palette.background;
        border-width: 1px;
        border-color: AppTheme.border;
        border-radius: 12px;
        drop-shadow-blur: 22px;
        drop-shadow-color: #00000055;
        drop-shadow-offset-y: 6px;

        VerticalLayout {
            x: 10px;
            y: 10px;
            width: parent.width - 20px;
            height: parent.height - 55px;
            spacing: 3px;

            Text {
                text: root.language-index == 1 ? "압축파일 만들기" : root.language-index == 2 ? "アーカイブを作成" : "Create archive";
                font-size: 21px;
                font-weight: 700;
                color: Palette.foreground;
            }

            Text {
                text: root.source-summary;
                color: Palette.foreground;
                opacity: 0.72;
                height: 20px;
                wrap: no-wrap;
                overflow: elide;
                vertical-alignment: center;
            }

            HorizontalLayout {
                spacing: 8px;

                Button {
                    text: root.language-index == 1 ? "파일 선택…" : root.language-index == 2 ? "ファイルを選択…" : "Choose files…";
                    clicked => { root.choose-files(); }
                }

                Button {
                    text: root.language-index == 1 ? "폴더 선택…" : root.language-index == 2 ? "フォルダーを選択…" : "Choose folder…";
                    clicked => { root.choose-folder(); }
                }

                Rectangle { horizontal-stretch: 1; }
            }

            HorizontalLayout {
                spacing: 12px;

                VerticalLayout {
                    spacing: 4px;
                    horizontal-stretch: 2;

                    Text {
                        text: root.language-index == 1 ? "형식" : root.language-index == 2 ? "形式" : "Format";
                        color: Palette.foreground;
                        font-weight: 600;
                    }

                    format := ComboBox {
                        model: root.available-formats;
                        current-index: 0;
                    }
                }

                VerticalLayout {
                    spacing: 4px;
                    horizontal-stretch: 1;

                    Text {
                        text: root.language-index == 1 ? "압축률" : root.language-index == 2 ? "レベル" : "Level";
                        color: Palette.foreground;
                        font-weight: 600;
                    }

                    level := SpinBox {
                        minimum: 0;
                        maximum: 9;
                        value: 5;
                        enabled: format.current-value != "TAR";
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;

                Text {
                    text: root.language-index == 1 ? "분할 크기" : root.language-index == 2 ? "分割サイズ" : "Split size";
                    color: Palette.foreground;
                    font-weight: 600;
                    width: 150px;
                    vertical-alignment: center;
                }

                volume-picker := ComboBox {
                    horizontal-stretch: 1;
                    enabled: format.current-value == "ZIP" || format.current-value == "7z";
                    model: root.language-index == 1
                        ? ["분할 안 함", "10 MB", "50 MB", "100 MB", "300 MB", "650 MB", "1 GB", "4 GB", "23 GB", "92.4 GB", root.volume-custom-label]
                        : root.language-index == 2
                            ? ["分割しない", "10 MB", "50 MB", "100 MB", "300 MB", "650 MB", "1 GB", "4 GB", "23 GB", "92.4 GB", root.volume-custom-label]
                            : ["Do not split", "10 MB", "50 MB", "100 MB", "300 MB", "650 MB", "1 GB", "4 GB", "23 GB", "92.4 GB", root.volume-custom-label];
                    current-index: root.volume-index;
                    changed current-index => { root.volume-index = self.current-index; }
                }
            }

            if root.show-volume-custom: HorizontalLayout {
                spacing: 8px;

                Rectangle { width: 150px; }

                LineEdit {
                    text <=> root.volume-custom-text;
                    horizontal-stretch: 1;
                    placeholder-text: root.language-index == 1
                        ? "예: 30MB, 1.5GB, 500KB"
                        : root.language-index == 2
                            ? "例: 30MB, 1.5GB, 500KB"
                            : "e.g. 30MB, 1.5GB, 500KB";
                }
            }

            HorizontalLayout {
                spacing: 8px;

                Text {
                    text: root.language-index == 1 ? "CPU 스레드 (7z)" : root.language-index == 2 ? "CPU スレッド（7z）" : "CPU threads (7z)";
                    color: Palette.foreground;
                    font-weight: 600;
                    width: 150px;
                    vertical-alignment: center;
                }

                thread-picker := ComboBox {
                    horizontal-stretch: 1;
                    model: root.language-index == 1
                        ? ["자동", "4", "6", "8", "10", "16", "전체"]
                        : root.language-index == 2
                            ? ["自動", "4", "6", "8", "10", "16", "すべて"]
                            : ["Auto", "4", "6", "8", "10", "16", "All"];
                    current-index: root.thread-index;
                    changed current-index => { root.thread-index = self.current-index; }
                }
            }

            HorizontalLayout {
                spacing: 6px;

                password := LineEdit {
                    horizontal-stretch: 1;
                    input-type: InputType.password;
                    enabled: format.current-value == "ZIP" || format.current-value == "7z";
                    placeholder-text: format.current-value == "ZIP" || format.current-value == "7z"
                        ? (root.language-index == 1 ? "암호 (선택)" : root.language-index == 2 ? "パスワード（任意）" : "Password (optional)")
                        : (root.language-index == 1 ? "ZIP/7z만 지원" : root.language-index == 2 ? "ZIP/7zのみ対応" : "ZIP / 7z only");
                }

                password-confirmation := LineEdit {
                    horizontal-stretch: 1;
                    input-type: InputType.password;
                    enabled: format.current-value == "ZIP" || format.current-value == "7z";
                    placeholder-text: root.language-index == 1 ? "암호 확인" : root.language-index == 2 ? "パスワード確認" : "Confirm password";
                }
            }

            header-encryption := CheckBox {
                visible: format.current-value == "7z";
                enabled: password.text != "";
                checked: root.header-encryption-default;
                text: root.language-index == 1
                    ? "파일명 암호화 (Header Encryption)"
                    : root.language-index == 2
                        ? "ファイル名を暗号化（Header Encryption）"
                        : "Encrypt file names (Header Encryption)";
            }

            Text {
                visible: root.password-error != "";
                text: root.password-error;
                color: #c53d3d;
                font-size: 12px;
                height: 16px;
                vertical-alignment: center;
            }

            Rectangle { vertical-stretch: 1; }

        }

        // Keep the action buttons fixed inside the dialog, even when the
        // source path changes the preferred height of the form content.
        HorizontalLayout {
            x: 10px;
            y: parent.height - self.height - 10px;
            width: parent.width - 20px;
            height: 32px;
            spacing: 8px;

            Rectangle { horizontal-stretch: 1; }

            Button {
                text: root.language-index == 1 ? "취소" : root.language-index == 2 ? "キャンセル" : "Cancel";
                clicked => { root.cancelled(); }
            }

            Button {
                text: root.language-index == 1 ? "만들기" : root.language-index == 2 ? "作成" : "Create";
                primary: true;
                enabled: root.has-sources && root.available-formats.length > 0;
                clicked => {
                    if (password.text != password-confirmation.text) {
                        root.password-error = root.language-index == 1
                            ? "암호가 일치하지 않습니다."
                            : root.language-index == 2
                                ? "パスワードが一致しません。"
                                : "Passwords do not match.";
                    } else {
                        root.password-error = "";
                        root.accepted(
                            format.current-index,
                            level.value,
                            root.thread-index,
                            root.volume-index,
                            root.volume-custom-text,
                            password.text,
                            password-confirmation.text,
                            header-encryption.checked && format.current-value == "7z" && password.text != ""
                        );
                    }
                }
            }
        }
    }
}

export component SettingsOverlay inherits Rectangle {
    in property <[string]> font-options;
    in property <int> font-selection;
    in property <int> thread-selection;
    in property <bool> header-encryption: false;
    in property <int> theme-selection;
    in property <bool> esc-close-main-window: false;
    in property <[string]> language-options;
    in property <int> language-selection;
    in property <int> language-preference-selection;
    in property <string> app-version;
    in property <string> context-menu-state;
    in property <bool> context-menu-managed-by-package: false;

    private property <int> active-tab: 0;
    private property <int> font-index: root.font-selection;
    private property <bool> header-encryption-value: root.header-encryption;
    private property <int> thread-index: root.thread-selection;
    private property <int> theme-index: root.theme-selection;
    private property <int> selected-language: root.language-preference-selection;
    private property <bool> esc-close-main-window-value: root.esc-close-main-window;

    callback accepted(int, int, int, int, bool, bool);
    callback cancelled();
    callback register-context-menu();
    callback unregister-context-menu();
    callback register-file-associations();
    callback unregister-file-associations();
    callback open-default-apps();
    callback open-github();
    callback open-third-party-notices();
    callback open-third-party-licenses();

    background: #00000080;
    accessible-role: region;
    accessible-label: root.active-tab == 1
        ? (root.language-selection == 1 ? "앱 등록" : root.language-selection == 2 ? "アプリ登録" : "App registration")
        : root.active-tab == 2
            ? (root.language-selection == 1 ? "정보" : root.language-selection == 2 ? "情報" : "About")
            : (root.language-selection == 1 ? "설정" : root.language-selection == 2 ? "設定" : "Settings");

    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 460px;
        height: 380px;
        background: Palette.background;
        border-width: 1px;
        border-color: AppTheme.border;
        border-radius: 12px;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000066;
        drop-shadow-offset-y: 8px;

        VerticalLayout {
            padding: 10px;
            spacing: 4px;

            Text {
                text: root.language-selection == 1 ? "설정" : root.language-selection == 2 ? "設定" : "Settings";
                font-size: 22px;
                font-weight: 700;
                color: Palette.foreground;
            }

            HorizontalLayout {
                spacing: 6px;

                settings-tab := Button {
                    horizontal-stretch: 1;
                    text: root.language-selection == 1 ? "설정" : root.language-selection == 2 ? "設定" : "Settings";
                    primary: root.active-tab == 0;
                    clicked => { root.active-tab = 0; }
                }

                app-registration-tab := Button {
                    horizontal-stretch: 1;
                    text: root.language-selection == 1 ? "앱 등록" : root.language-selection == 2 ? "アプリ登録" : "App registration";
                    primary: root.active-tab == 1;
                    clicked => { root.active-tab = 1; }
                }

                about-tab := Button {
                    horizontal-stretch: 1;
                    text: root.language-selection == 1 ? "정보" : root.language-selection == 2 ? "情報" : "About";
                    primary: root.active-tab == 2;
                    clicked => { root.active-tab = 2; }
                }
            }

            if root.active-tab == 0 : VerticalLayout {
                spacing: 4px;
                vertical-stretch: 0;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: root.language-selection == 1 ? "언어" : root.language-selection == 2 ? "言語" : "Language";
                        color: Palette.foreground;
                        font-weight: 600;
                        width: 150px;
                        vertical-alignment: center;
                    }
                    language := ComboBox {
                        height: 28px;
                        horizontal-stretch: 1;
                        model: root.language-options;
                        current-index: root.selected-language;
                        changed current-index => { root.selected-language = self.current-index; }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: root.language-selection == 1 ? "7z 파일명 암호화" : root.language-selection == 2 ? "7z ファイル名暗号化" : "7z Header Encryption";
                        color: Palette.foreground;
                        font-weight: 600;
                        width: 150px;
                        vertical-alignment: center;
                    }
                    header-encryption := CheckBox {
                        horizontal-stretch: 1;
                        checked: root.header-encryption-value;
                        changed checked => { root.header-encryption-value = self.checked; }
                        text: root.language-selection == 1
                            ? "암호 설정 시 파일명 숨기기"
                            : root.language-selection == 2
                                ? "パスワード設定時にファイル名を隠す"
                                : "Hide names when a password is set";
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: root.language-selection == 1 ? "인터페이스 글꼴" : root.language-selection == 2 ? "インターフェースフォント" : "Interface font";
                        color: Palette.foreground;
                        font-weight: 600;
                        width: 150px;
                        vertical-alignment: center;
                    }
                    font := ComboBox {
                        height: 28px;
                        horizontal-stretch: 1;
                        model: root.font-options;
                        current-index: root.font-index;
                        changed current-index => { root.font-index = self.current-index; }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: root.language-selection == 1 ? "CPU 스레드 (7z)" : root.language-selection == 2 ? "CPU スレッド（7z）" : "CPU threads (7z)";
                        color: Palette.foreground;
                        font-weight: 600;
                        width: 150px;
                        vertical-alignment: center;
                    }
                    thread-picker := ComboBox {
                        height: 28px;
                        horizontal-stretch: 1;
                        model: root.language-selection == 1
                            ? ["자동", "4", "6", "8", "10", "16", "전체"]
                            : root.language-selection == 2
                                ? ["自動", "4", "6", "8", "10", "16", "すべて"]
                                : ["Auto", "4", "6", "8", "10", "16", "All"];
                        current-index: root.thread-index;
                        changed current-index => { root.thread-index = self.current-index; }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: root.language-selection == 1 ? "테마" : root.language-selection == 2 ? "テーマ" : "Theme";
                        color: Palette.foreground;
                        font-weight: 600;
                        width: 150px;
                        vertical-alignment: center;
                    }
                    theme := ComboBox {
                        height: 28px;
                        horizontal-stretch: 1;
                        model: root.language-selection == 1
                            ? ["시스템", "라이트", "다크"]
                            : root.language-selection == 2
                                ? ["システム", "ライト", "ダーク"]
                                : ["System", "Light", "Dark"];
                        current-index: root.theme-index;
                        changed current-index => { root.theme-index = self.current-index; }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: root.language-selection == 1 ? "ESC 동작" : root.language-selection == 2 ? "ESCキー動作" : "Escape key behavior";
                        color: Palette.foreground;
                        font-weight: 600;
                        width: 150px;
                        vertical-alignment: center;
                    }
                    esc-close := CheckBox {
                        horizontal-stretch: 1;
                        checked: root.esc-close-main-window-value;
                        changed checked => { root.esc-close-main-window-value = self.checked; }
                        text: root.language-selection == 1
                            ? "ESC로 메인 창 닫기"
                            : root.language-selection == 2
                                ? "ESCキーでメインウィンドウを閉じる"
                                : "Close the main window with Escape";
                    }
                }

            }

            if root.active-tab == 1 : VerticalLayout {
                spacing: 4px;
                vertical-stretch: 0;

                Text {
                    text: root.language-selection == 1 ? "Explorer 우클릭 메뉴" : root.language-selection == 2 ? "Explorer 右クリックメニュー" : "Explorer right-click menu";
                    font-weight: 600;
                    color: Palette.foreground;
                }

                HorizontalLayout {
                    spacing: 8px;

                    Text {
                        text: root.context-menu-state;
                        color: Palette.foreground;
                        font-size: 12px;
                        opacity: 0.72;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    Button {
                        height: 28px;
                        text: root.language-selection == 1 ? "등록" : root.language-selection == 2 ? "登録" : "Register";
                        clicked => { root.register-context-menu(); }
                    }

                    Button {
                        height: 28px;
                        text: root.language-selection == 1 ? "제거" : root.language-selection == 2 ? "削除" : "Remove";
                        clicked => { root.unregister-context-menu(); }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: AppTheme.border;
                }

                Text {
                    text: root.language-selection == 1 ? "지원 파일 확장자" : root.language-selection == 2 ? "対応ファイル拡張子" : "Supported file extensions";
                    font-weight: 600;
                    color: Palette.foreground;
                }

                Text {
                    text: root.language-selection == 1
                        ? "ArchiveRclick을 Windows 기본 앱 목록에 등록합니다. 등록 후 기본 앱 설정에서 .zip, .7z 등 지원 확장자의 기본 앱으로 지정할 수 있습니다."
                        : root.language-selection == 2
                            ? "ArchiveRclickをWindowsの既定のアプリ一覧に登録します。登録後、既定のアプリ設定で.zipや.7zなどの対応拡張子を指定できます。"
                            : "Registers ArchiveRclick in Windows Default apps. After registering, choose it as the default app for supported extensions such as .zip and .7z.";
                    color: Palette.foreground;
                    font-size: 11px;
                    opacity: 0.72;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;

                    Button {
                        height: 28px;
                        text: root.language-selection == 1 ? "앱 등록" : root.language-selection == 2 ? "アプリを登録" : "Register app";
                        clicked => { root.register-file-associations(); }
                    }

                    Button {
                        height: 28px;
                        text: root.language-selection == 1 ? "기본 앱 설정 열기" : root.language-selection == 2 ? "既定のアプリを開く" : "Open Default apps";
                        clicked => { root.open-default-apps(); }
                    }

                    Button {
                        height: 28px;
                        text: root.language-selection == 1 ? "등록 제거" : root.language-selection == 2 ? "登録を削除" : "Remove registration";
                        clicked => { root.unregister-file-associations(); }
                    }
                }
            }

            if root.active-tab == 2 : VerticalLayout {
                spacing: 4px;
                vertical-stretch: 0;

                HorizontalLayout {
                    spacing: 12px;
                    height: 78px;

                    Image {
                        source: @image-url("../app.png");
                        width: 78px;
                        height: 78px;
                    }

                    VerticalLayout {
                        spacing: 2px;
                        vertical-stretch: 1;

                        Text {
                            text: "ArchiveRclick";
                            font-size: 22px;
                            font-weight: 700;
                            color: Palette.foreground;
                        }

                        Text {
                            text: root.language-selection == 1 ? "버전 " + root.app-version : root.language-selection == 2 ? "バージョン " + root.app-version : "Version " + root.app-version;
                            color: Palette.foreground;
                            opacity: 0.78;
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: AppTheme.border;
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: root.language-selection == 1 ? "프로젝트 GitHub" : root.language-selection == 2 ? "プロジェクト GitHub" : "Project GitHub";
                        color: Palette.foreground;
                        font-weight: 600;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Button {
                        height: 28px;
                        text: root.language-selection == 1 ? "GitHub 열기" : root.language-selection == 2 ? "GitHubを開く" : "Open GitHub";
                        clicked => { root.open-github(); }
                    }
                }

                Text {
                    text: "https://github.com/kirinonakar/ArchiveRclick";
                    color: Palette.foreground;
                    font-size: 12px;
                    opacity: 0.72;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: root.language-selection == 1 ? "Third-party 라이선스" : root.language-selection == 2 ? "サードパーティライセンス" : "Third-party licenses";
                        color: Palette.foreground;
                        font-weight: 600;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Button {
                        height: 28px;
                        text: root.language-selection == 1 ? "고지 열기" : root.language-selection == 2 ? "告知を開く" : "Open notices";
                        clicked => { root.open-third-party-notices(); }
                    }
                }

                Text {
                    text: root.language-selection == 1
                        ? "THIRD-PARTY-NOTICES.md에 포함된 라이선스 고지를 기본 프로그램으로 엽니다."
                        : root.language-selection == 2
                            ? "THIRD-PARTY-NOTICES.md に含まれるライセンス告知を既定のアプリで開きます。"
                            : "Opens the bundled THIRD-PARTY-NOTICES.md in the default application.";
                    color: Palette.foreground;
                    font-size: 12px;
                    opacity: 0.72;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        height: 28px;
                        text: root.language-selection == 1 ? "라이선스 열기" : root.language-selection == 2 ? "ライセンスを開く" : "Open licenses";
                        clicked => { root.open-third-party-licenses(); }
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                spacing: 8px;
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: root.language-selection == 1 ? "취소" : root.language-selection == 2 ? "キャンセル" : "Cancel";
                    clicked => { root.cancelled(); }
                }
                Button {
                    text: root.language-selection == 1 ? "확인" : root.language-selection == 2 ? "OK" : "OK";
                    primary: true;
                    clicked => { root.accepted(root.font-index, root.thread-index, root.theme-index, root.selected-language, root.header-encryption-value, root.esc-close-main-window-value); }
                }
            }
        }
    }
}
